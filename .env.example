# ─────────────────────────────────────────────
#  Copy this file to .env and fill in the values
#  cp .env.example .env
# ─────────────────────────────────────────────

# ── Project ───────────────────────────────────
COMPOSE_PROJECT_NAME=myproject

# ── PostgreSQL ────────────────────────────────
DB_NAME=myproject_db
DB_USER=myproject_user
DB_PASSWORD=changeme_strong_password
DB_HOST=db
DB_PORT=5432

# ── Django ────────────────────────────────────
DJANGO_ENV=development            # development | production
DJANGO_SECRET_KEY=changeme_generate_a_strong_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Gunicorn ──────────────────────────────────
GUNICORN_WORKERS=2

# ── Backend (Django) ──────────────────────────
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────
FRONTEND_TARGET=development       # development | production
FRONTEND_PORT=5173
VITE_API_URL=http://localhost/api

# ── Nginx ─────────────────────────────────────
NGINX_PORT=80
