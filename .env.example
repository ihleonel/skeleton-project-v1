# ─────────────────────────────────────────────
#  Copy this file to .env and fill in the values
#  cp .env.example .env
# ─────────────────────────────────────────────

# ── Project ───────────────────────────────────
COMPOSE_PROJECT_NAME=myproject

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=myproject_db
POSTGRES_USER=myproject_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Django ────────────────────────────────────
DJANGO_ENV=development            # development | production
DJANGO_SECRET_KEY=changeme_generate_a_strong_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Gunicorn ──────────────────────────────────
GUNICORN_WORKERS=2

# ── Frontend ──────────────────────────────────
FRONTEND_TARGET=development       # development | production
VITE_API_BASE_URL=http://localhost/api

# ── Nginx ─────────────────────────────────────
NGINX_HTTP_PORT=80
